import { expect } from "chai";
import { ethers } from "hardhat";
import { HardhatEthersSigner } from "@nomicfoundation/hardhat-ethers/signers";

describe("Layer Infinite & Dollar1usd Integration Suite", function () {
  let ide: any;
  let token: any;
  let owner: HardhatEthersSigner;
  let delegatee: HardhatEthersSigner;
  let user: HardhatEthersSigner;
  const chainId = 1;

  beforeEach(async function () {
    [owner, delegatee, user] = await ethers.getSigners();

    // 1. نشر محرك التفويض
    const IDEFactory = await ethers.getContractFactory("InfiniteDelegationEngine");
    ide = await IDEFactory.deploy();
    await ide.waitForDeployment();

    // 2. نشر عقد التوكن المستقر
    const TokenFactory = await ethers.getContractFactory("Dollar1usdToken");
    token = await TokenFactory.deploy();
    await token.waitForDeployment();

    // 3. منح الصلاحية للمحرك داخل التوكن (محاكاة لسكريبت النشر)
    await token.connect(owner).updateAuthorityStatus(await ide.getAddress(), true);
  });

  describe("1. Infrastructure Authorization Check", function () {
    it("Should confirm that IDE is registered in the token's Authority Cluster", async function () {
      expect(await token.isAuthorityCluster(await ide.getAddress())).to.be.true;
    });

    it("Should reject direct protected minting from unauthorized users", async function () {
      const mintAmount = ethers.parseUnits("1000", 18);
      await expect(
        token.connect(user).mintProtected(user.address, mintAmount)
      ).to.be.revertedWith("Dollar1usd: Caller is not authorized");
    });
  });

  describe("2. EIP-7702 Delegation and MEV Gas Verification", function () {
    it("Should enforce maxGasPrice rules upon infrastructure requests", async function () {
      const lowGasCap = ethers.parseUnits("5", "gwei");
      await ide.connect(owner).createDelegation(delegatee.address, chainId, lowGasCap);

      const payload = "0x";
      const signature = "0x" + "0".repeat(130);

      // الفحص يجب أن يرفض المعاملة لأن غاز الشبكة الافتراضي أعلى من 5 جيواي لحماية المستخدم من الـ MEV
      await expect(
        ide.connect(delegatee).verifyAndExecute(owner.address, chainId, await token.getAddress(), payload, signature)
      ).to.be.revertedWith("IDE: Gas price exceeds MEV limit");
    });
  });
});
